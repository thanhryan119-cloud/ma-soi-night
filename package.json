{
  "name": "ma-soi-night",
  "version": "1.0.0",
  "private": true,
  "description": "Ma Sói Night — realtime Werewolf host & player app",
  "scripts": {
    "dev": "concurrently -n web,server -c magenta,cyan \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "next dev -H 0.0.0.0 -p 3000",
    "dev:server": "tsx watch server/index.ts --port 4000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "server": "tsx server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^16.4.6",
    "next-intl": "^4.15.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.7",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "5.9",
    "vitest": "^5.1.0"
  }
}
