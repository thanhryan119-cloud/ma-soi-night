# Web (Next.js) — URL of the Socket.IO server. Leave empty in local dev:
# the client then uses http://<same-hostname>:4000 so phones on the LAN work.
NEXT_PUBLIC_SOCKET_URL=

# Socket server
PORT=4000
# Comma separated list of allowed web origins (default: *)
CORS_ORIGIN=*

# Shop (payOS): https://my.payos.vn → Kênh thanh toán → keys. Leave empty to keep the shop closed.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Where payOS sends buyers back (optional; default: the web origin that opened the checkout)
PUBLIC_WEB_URL=
# Google emails allowed to manage discount codes at /admin/codes (comma separated)
ADMIN_EMAILS=
