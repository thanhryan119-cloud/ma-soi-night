# Web (Next.js) — URL of the Socket.IO server. Leave empty in local dev:
# the client then uses http://<same-hostname>:4000 so phones on the LAN work.
NEXT_PUBLIC_SOCKET_URL=

# Socket server
PORT=4000
# Comma separated list of allowed web origins (default: *)
CORS_ORIGIN=*

# Voice chat relay (TURN). Without it, voice often fails between phones on 4G or carrier NAT.
# Cloudflare: dash.cloudflare.com → Realtime → TURN Server → create a key (free tier).
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Or any other TURN server (comma separated turn: / turns: URLs)
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Donations (payOS): https://my.payos.vn → Kênh thanh toán → keys. Leave empty to keep the donate page closed.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Where payOS sends donors back (optional; default: the web origin that opened the donate page)
PUBLIC_WEB_URL=
# Discord channel webhook (Server Settings → Integrations → Webhooks). Each new room is posted there. Empty = off.
# Join links in the post use PUBLIC_WEB_URL when it is set.
DISCORD_WEBHOOK_URL=
# Discord guide bot (Developer Portal → your app → General Information). Empty = off.
# The server only needs the public key. App id and bot token are for `npm run discord:register`.
DISCORD_PUBLIC_KEY=
DISCORD_APP_ID=
DISCORD_BOT_TOKEN=
# Optional: register the commands on one server so they show up at once
DISCORD_GUILD_ID=
# Google emails with admin rights, e.g. server chat moderation (comma separated)
ADMIN_EMAILS=
